                              description="Derived Column Friendly Expression"
                              expressionType="Notify"
                              name="FriendlyExpression">RIGHT("0000" + SUBSTRING([Copy of age],FINDSTRING([Copy of age],"/",2) + 1,4),4) + "-" + RIGHT("00" + SUBSTRING([Copy of age],1,FINDSTRING([Copy of age],"/",1) - 1),2) + "-" + RIGHT("00" + SUBSTRING([Copy of age],FINDSTRING([Copy of age],"/",1) + 1,FINDSTRING([Copy of age],"/",2) - FINDSTRING([Copy of age],"/",1) - 1),2)</property>
