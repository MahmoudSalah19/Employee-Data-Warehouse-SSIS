                          truncationRowDisposition="FailComponent">
                          <properties>
                            <property
                              containsID="true"
                              dataType="System.String"
                              description="Derived Column Expression"
                              name="Expression">[RIGHT]("0000" + [SUBSTRING](#{Package\Sequence Container\ODS\Excel Data Conversion.Outputs[Data Conversion Output].Columns[Copy of age]},[FINDSTRING](#{Package\Sequence Container\ODS\Excel Data Conversion.Outputs[Data Conversion Output].Columns[Copy of age]},"/",2) + 1,4),4) + "-" + [RIGHT]("00" + [SUBSTRING](#{Package\Sequence Container\ODS\Excel Data Conversion.Outputs[Data Conversion Output].Columns[Copy of age]},1,[FINDSTRING](#{Package\Sequence Container\ODS\Excel Data Conversion.Outputs[Data Conversion Output].Columns[Copy of age]},"/",1) - 1),2) + "-" + [RIGHT]("00" + [SUBSTRING](#{Package\Sequence Container\ODS\Excel Data Conversion.Outputs[Data Conversion Output].Columns[Copy of age]},[FINDSTRING](#{Package\Sequence Container\ODS\Excel Data Conversion.Outputs[Data Conversion Output].Columns[Copy of age]},"/",1) + 1,[FINDSTRING](#{Package\Sequence Container\ODS\Excel Data Conversion.Outputs[Data Conversion Output].Columns[Copy of age]},"/",2) - [FINDSTRING](#{Package\Sequence Container\ODS\Excel Data Conversion.Outputs[Data Conversion Output].Columns[Copy of age]},"/",1) - 1),2)</property>
