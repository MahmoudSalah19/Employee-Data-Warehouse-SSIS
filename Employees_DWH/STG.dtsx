            <component
              refId="Package\dim_employee\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CleanedData AS
(
    SELECT
        id,
        'EMP-' + TRIM(id) AS employee_code,
        TRIM(first_name) AS first_name,
        TRIM(last_name) AS last_name,
        TRIM(email) AS email,
        ISNULL(
            CASE
                WHEN CleanPhone IS NULL OR TRIM(CleanPhone) = ''
                    THEN NULL
                ELSE CleanPhone
            END,
            'Unknown'
        ) AS phone,
        manager_id,
        TRIM(record_source) AS record_source
    FROM
    (
        SELECT
            id,
            employee_code,
            first_name,
            last_name,
            CASE
                WHEN email LIKE '% at %'
                    THEN REPLACE(email, ' at ', '@')
                WHEN email NOT LIKE '%[A-Za-z0-9._-]%@%[A-Za-z0-9.-]%.[A-Za-z]%'
                    THEN 'Unknown'
                ELSE email
            END AS email,
            manager_id,
            record_source,
            REPLACE(
                REPLACE(
                    REPLACE(
                        REPLACE(
                            REPLACE(TRIM(phone), ' ', ''),
                        '(', ''),
                    ')', ''),
                '-', ''),
            '+', '') AS CleanPhone
        FROM [HR_ODS].[dbo].[OBT]
    ) AS sub
),
RankedData AS
(
    SELECT *,
        ROW_NUMBER() OVER (
            PARTITION BY id
            ORDER BY id
        ) AS rn
    FROM CleanedData
)
SELECT
    id,
    employee_code,
    first_name,
    last_name,
    email,
    phone,
    manager_id,
    record_source
FROM RankedData
WHERE rn = 1;</property>
