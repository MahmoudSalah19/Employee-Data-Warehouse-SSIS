              <outputs>
                <output
                  refId="Package\dim_date\Derived Column.Outputs[Derived Column Output]"
                  description="Default Output of the Derived Column Transformation"
                  exclusionGroup="1"
                  name="Derived Column Output"
                  synchronousInputId="Package\dim_date\Derived Column.Inputs[Derived Column Input]">
                  <outputColumns>
                    <outputColumn
                      refId="Package\dim_date\Derived Column.Outputs[Derived Column Output].Columns[date_key]"
                      dataType="ui4"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      lineageId="Package\dim_date\Derived Column.Outputs[Derived Column Output].Columns[date_key]"
                      name="date_key"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_UI4)([YEAR](#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) * 10000 + [MONTH](#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) * 100 + [DAY](#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}))</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(DT_UI4)(YEAR(full_date) * 10000 + MONTH(full_date) * 100 + DAY(full_date))</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\dim_date\Derived Column.Outputs[Derived Column Output].Columns[is_weekend]"
                      dataType="bool"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      lineageId="Package\dim_date\Derived Column.Outputs[Derived Column Output].Columns[is_weekend]"
                      name="is_weekend"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">[DATEPART]("weekday",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 6 || [DATEPART]("weekday",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 7 ?  TRUE  :  FALSE </property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">DATEPART("weekday",full_date) == 6 || DATEPART("weekday",full_date) == 7 ?  TRUE  :  FALSE </property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\dim_date\Derived Column.Outputs[Derived Column Output].Columns[month_name]"
                      dataType="wstr"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      length="9"
                      lineageId="Package\dim_date\Derived Column.Outputs[Derived Column Output].Columns[month_name]"
                      name="month_name"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">[DATEPART]("month",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 1 ? "January" : [DATEPART]("month",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 2 ? "February" : [DATEPART]("month",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 3 ? "March" : [DATEPART]("month",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 4 ? "April" : [DATEPART]("month",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 5 ? "May" : [DATEPART]("month",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 6 ? "June" : [DATEPART]("month",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 7 ? "July" : [DATEPART]("month",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 8 ? "August" : [DATEPART]("month",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 9 ? "September" : [DATEPART]("month",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 10 ? "October" : [DATEPART]("month",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 11 ? "November" : "December"</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">DATEPART("month",full_date) == 1 ? "January" : DATEPART("month",full_date) == 2 ? "February" : DATEPART("month",full_date) == 3 ? "March" : DATEPART("month",full_date) == 4 ? "April" : DATEPART("month",full_date) == 5 ? "May" : DATEPART("month",full_date) == 6 ? "June" : DATEPART("month",full_date) == 7 ? "July" : DATEPART("month",full_date) == 8 ? "August" : DATEPART("month",full_date) == 9 ? "September" : DATEPART("month",full_date) == 10 ? "October" : DATEPART("month",full_date) == 11 ? "November" : "December"</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\dim_date\Derived Column.Outputs[Derived Column Output].Columns[day_name]"
                      dataType="wstr"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      length="9"
                      lineageId="Package\dim_date\Derived Column.Outputs[Derived Column Output].Columns[day_name]"
                      name="day_name"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">[DATEPART]("weekday",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 1 ? "Sunday" : [DATEPART]("weekday",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 2 ? "Monday" : [DATEPART]("weekday",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 3 ? "Tuesday" : [DATEPART]("weekday",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 4 ? "Wednesday" : [DATEPART]("weekday",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 5 ? "Thursday" : [DATEPART]("weekday",#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) == 6 ? "Friday" : "Saturday"</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">DATEPART("weekday",full_date) == 1 ? "Sunday" : DATEPART("weekday",full_date) == 2 ? "Monday" : DATEPART("weekday",full_date) == 3 ? "Tuesday" : DATEPART("weekday",full_date) == 4 ? "Wednesday" : DATEPART("weekday",full_date) == 5 ? "Thursday" : DATEPART("weekday",full_date) == 6 ? "Friday" : "Saturday"</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\dim_date\Derived Column.Outputs[Derived Column Output].Columns[year_month]"
                      dataType="wstr"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      length="7"
                      lineageId="Package\dim_date\Derived Column.Outputs[Derived Column Output].Columns[year_month]"
                      name="year_month"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_WSTR,4)[YEAR](#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]}) + "-" + (DT_WSTR,2)[MONTH](#{Package\dim_date\OLE DB Source.Outputs[OLE DB Source Output].Columns[full_date]})</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(DT_WSTR,4)YEAR(full_date) + "-" + (DT_WSTR,2)MONTH(full_date)</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\dim_date\Derived Column.Outputs[Derived Column Output].Columns[year]"
                      dataType="ui2"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      lineageId="Package\dim_date\Derived Column.Outputs[Derived Column Output].Columns[year]"
