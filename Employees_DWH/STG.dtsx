                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
TRIM(employment_type) AS employment_type,
ISNULL(NULLIF(TRIM(work_mode), N''), N'Unknown') AS work_mode,
TRIM(employment_status) AS employment_status,
CASE WHEN is_active = N'false' THEN N'False'
	 WHEN is_active = N'true' THEN N'True'
ELSE is_active END AS is_active
  FROM [HR_ODS].[dbo].[OBT]</property>
