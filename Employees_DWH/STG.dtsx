                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
      ISNULL(NULLIF(TRIM([education_level]), N''), N'Unknown') AS education_level,
      CASE education_level
        WHEN N'High School' THEN 1
        WHEN N'Diploma' THEN 2
        WHEN N'Bachelor' THEN 3
        WHEN N'Master' THEN 4
        WHEN N'PhD' THEN 5
        WHEN N'Unknown' THEN 0
        ELSE 0
        END AS education_rank
  FROM [HR_ODS].[dbo].[OBT]</property>
