                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
ISNULL(NULLIF(TRIM([performance_rating]),''), 0) AS [performance_rating],
CASE [performance_rating]
          WHEN '1' THEN N'Weak'
          WHEN '2' THEN N'Below Average'
          WHEN '3' THEN N'Average'
          WHEN '4' THEN N'Good'
          WHEN '5' THEN N'Excellent'
          ELSE N'Unknown' END AS rating_label
FROM [HR_ODS].[dbo].[OBT]</property>
