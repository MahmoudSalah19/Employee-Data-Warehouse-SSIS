            <component
              refId="Package\dim_date\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT full_date
FROM (
    SELECT CASE
               WHEN SUBSTRING(LTRIM(RTRIM(termination_date)), 3, 1) = '/'
                   THEN TRY_CONVERT(DATE, LEFT(LTRIM(RTRIM(termination_date)), 10), 103)
               ELSE TRY_CONVERT(DATE, LEFT(LTRIM(RTRIM(termination_date)), 10), 23)
           END AS full_date
    FROM [HR_ODS].[dbo].[OBT]

    UNION

    SELECT CASE
               WHEN SUBSTRING(LTRIM(RTRIM(last_promotion_date)), 3, 1) = '/'
                   THEN TRY_CONVERT(DATE, LEFT(LTRIM(RTRIM(last_promotion_date)), 10), 103)
               ELSE TRY_CONVERT(DATE, LEFT(LTRIM(RTRIM(last_promotion_date)), 10), 23)
           END
    FROM [HR_ODS].[dbo].[OBT]

    UNION

    SELECT CASE
               WHEN SUBSTRING(LTRIM(RTRIM(hire_date)), 3, 1) = '/'
                   THEN TRY_CONVERT(DATE, LEFT(LTRIM(RTRIM(hire_date)), 10), 103)
               ELSE TRY_CONVERT(DATE, LEFT(LTRIM(RTRIM(hire_date)), 10), 23)
           END
    FROM [HR_ODS].[dbo].[OBT]

    UNION

    SELECT TRY_CONVERT(DATE, LEFT(LTRIM(RTRIM(dob)), 10), 23)
    FROM [HR_ODS].[dbo].[OBT]

    UNION

    SELECT CASE
               WHEN SUBSTRING(LTRIM(RTRIM(updated_at)), 3, 1) = '/'
                   THEN TRY_CONVERT(DATE, LEFT(LTRIM(RTRIM(updated_at)), 10), 103)
               ELSE TRY_CONVERT(DATE, LEFT(LTRIM(RTRIM(updated_at)), 10), 23)
           END
    FROM [HR_ODS].[dbo].[OBT]

    UNION

    SELECT CASE
               WHEN SUBSTRING(LTRIM(RTRIM(created_at)), 3, 1) = '/'
                   THEN TRY_CONVERT(DATE, LEFT(LTRIM(RTRIM(created_at)), 10), 103)
               ELSE TRY_CONVERT(DATE, LEFT(LTRIM(RTRIM(created_at)), 10), 23)
           END
    FROM [HR_ODS].[dbo].[OBT]
) AS AllDates
WHERE full_date IS NOT NULL
ORDER BY full_date;</property>
